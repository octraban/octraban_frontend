# Frontend environment — copy this file to .env before running `npm run dev`
#
#   cp .env.example .env

# Dev-server proxy target for relative "/api" requests (see server.proxy in
# vite.config.ts). Only read by `npm run dev`; nginx handles the equivalent
# "/api/" proxy in the Docker image (see nginx.conf).
VITE_INDEXER_URL=http://localhost:3001

# Public indexer origin used directly by browser API/SSE/WebSocket calls in
# static production deployments (such as Vercel) where no local "/api" proxy
# exists. Leave unset in local dev or Docker/nginx to keep relative "/api"
# requests routed through Vite or nginx.
# VITE_API_URL=https://indexer.example.com

# Active network's Soroban RPC endpoint and passphrase, resolved by
# src/config/network.ts (defaults to Stellar testnet when unset).
VITE_SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
VITE_NETWORK_PASSPHRASE="Test SDF Network ; September 2015"
