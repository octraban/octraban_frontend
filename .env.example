# Frontend environment — copy this file to .env before running `npm run dev`
#
#   cp frontend/.env.example frontend/.env

# Dev-server proxy target for the relative "/api" path (see server.proxy in
# vite.config.ts). Only used by `npm run dev`; nginx covers the equivalent
# proxying in the Docker image (see nginx.conf). Leave unset to use the
# default below.
VITE_INDEXER_URL=http://localhost:3001

# Base URL the app talks to the indexer through directly — required for
# production builds, where there is no dev-server proxy.
#   - src/api.ts: unset falls back to the relative "/api" path, proxied via
#     VITE_INDEXER_URL above (dev) or nginx (Docker image).
#   - src/services/sandbox-api.ts: unset falls back to http://localhost:3001.
VITE_API_URL=http://localhost:3001

# Active network's RPC URL and passphrase, resolved by src/config/network.ts
# and consumed via useNetwork()/resolveActiveNetwork() wherever a transaction
# is built, simulated, or signed (Sandbox templates, SDK snippets, etc).
# Both default to Stellar testnet when unset. Switching to mainnet or
# futurenet at runtime is handled by the NetworkSwitcher UI, which layers
# builtin/custom networks on top of this default.
VITE_SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
VITE_NETWORK_PASSPHRASE="Test SDF Network ; September 2015"
